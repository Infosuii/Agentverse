# Jane Avenue Environment Configuration
# Copy this file to .env and adjust values as needed. Never commit .env!

# Google Gemini API key. Leave empty for mock mode; set a valid key to enable live mode.
GEMINI_API_KEY=

# Runtime mode:
# - "mock"   : deterministic fixtures, zero network calls (default when GEMINI_API_KEY is unset)
# - "live"   : real Gemini Interactions API + Google Search grounding + official document fetch
# - "cached" : replays recorded live research runs from JANE_RESEARCH_CACHE_DIR
# Default: "live" if GEMINI_API_KEY is set, otherwise "mock"
JANE_MODE=mock

# Fast Gemini model used for research loop, policy parser, verification critic, and report drafting
JANE_MODEL_FAST=gemini-3.8-flash

# Deep Gemini model (optional) used for research synthesis or verification critic
JANE_MODEL_DEEP=gemini-4-argon

# Path to curated official datasets and provenance metadata (.csv + .meta.json)
JANE_DATA_DIR=data

# Path to cached live research runs keyed by canonical PolicySpec SHA-256 hash
JANE_RESEARCH_CACHE_DIR=data/research_cache

# Path to SQLite database file for storing analyses and SSE events (use :memory: in tests)
JANE_DB_PATH=backend/.data/jane.db

# Default Monte Carlo simulation draw count (0 to 20000)
JANE_MC_DRAWS=2000

# Default random number generator seed for deterministic Monte Carlo runs
JANE_SEED=42

# Comma-separated list of allowed CORS origins for the FastAPI backend
JANE_CORS_ORIGINS=http://localhost:5173
